model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Customer","Date","Product","Fact - Sales","Store"]

annotation PBI_ProTooling = ["DevMode"]

ref table Customer
ref table Date
ref table Product
ref table 'Fact - Sales'
ref table Store
ref table '⍟ Big & Bulky Measures'
ref table '⌂ Local Measures'

ref cultureInfo en-US

